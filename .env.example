PP_ACCENT_COLOR=7167484
PP_MAX_PLAYERS=100
PP_ANNOUNCE_COOLDOWN_SECONDS=60

# Identifiant Discord du gestionnaire de PP (Minimoys).
PP_CREATOR_DISCORD_ID=1563237640655085670

# Optionnel : rôle autorisant des files de 4 ou 5 minutes.
PP_EXTENDED_DELAY_ROLE_ID=
# Bannière fine intégrée automatiquement ; URL HTTPS facultative pour la remplacer.
PP_BANNER_URL=

# Connexion Epic Games de Minimoys (Epic Account Services OAuth)
